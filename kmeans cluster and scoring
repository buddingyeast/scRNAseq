  as.data.frame() %>%
  rownames_to_column("TF") %>%
  pivot_longer(-TF, names_to = "cell_stage", values_to = "avg_expression")

tf_expression <- tf_avg_long %>%
  mutate(cell_stage = gsub("-", "_", cell_stage)) %>%
  left_join(
    tf_pct %>% mutate(cell_stage = gsub("-", "_", cell_stage)),
    by = c("TF", "cell_stage"))

############################################################
# Identify states in which each HSCR program centroid is > 0
############################################################

active_states <- lapply(colnames(cluster_centroids), function(cl) {
  rownames(cluster_centroids)[cluster_centroids[, cl] > 0]})

names(active_states) <- colnames(cluster_centroids)

############################################################
# Program-specific TF prevalence/expression
############################################################

program_expression_stats <- map_dfr(seq_len(nrow(tf_program_cor)), function(i) {
  tf <- tf_program_cor$TF[i]
  program <- tf_program_cor$best_program[i]

  states <- gsub("-", "_", active_states[[program]])

  dat <- tf_expression %>%
    filter(TF == tf, cell_stage %in% states)

  tibble(
    TF = tf,
    best_program = program,
    mean_pct_active_states = if (nrow(dat) > 0) mean(dat$pct_expressing, na.rm = TRUE) else NA_real_,
    mean_expression_active_states = if (nrow(dat) > 0) mean(dat$avg_expression, na.rm = TRUE) else NA_real_
  )})

############################################################
# Final TF candidate table
############################################################

TF_candidates <- tf_program_cor %>%
  left_join(program_expression_stats, by = c("TF", "best_program")) %>%
  left_join(tf_perm_results, by = "TF") %>%
  arrange(desc(best_r))

############################################################
# Add strongest absolute correlation for reference
############################################################

TF_candidates <- TF_candidates %>%
  rowwise() %>%
  mutate(
    strongest_abs_r = max(abs(c_across(all_of(program_cols))), na.rm = TRUE),
    strongest_abs_program = program_cols[which.max(abs(c_across(all_of(program_cols))))]
  ) %>%
  ungroup()

############################################################
# Classify TFs
#
# These thresholds are good exploratory starting points.
# Inspect distributions before treating them as final.
############################################################

TF_candidates <- TF_candidates %>%
  mutate(
    match_class = case_when(
      empirical_padj >= 0.05 | best_r < 0.40 ~ "No program match",
      delta_r < 0.10 ~ "Shared/multi-program",
      TRUE ~ "Program-specific"),
    program_assignment = case_when(
      match_class == "Program-specific" ~ best_program,
      match_class == "Shared/multi-program" ~ "Shared",
      TRUE ~ "Unassigned"))

############################################################
# Inspect filtering statistics before finalizing thresholds
############################################################

summary(TF_candidates$best_r)
summary(TF_candidates$delta_r)
summary(TF_candidates$empirical_padj)

table(TF_candidates$match_class)
table(TF_candidates$best_program)
table(TF_candidates$program_assignment)

hist(
  TF_candidates$best_r,
  breaks = 20,
  main = "Best TF-HSCR program correlation",
  xlab = "Best Pearson r")

hist(
  TF_candidates$delta_r,
  breaks = 20,
  main = "TF program specificity",
  xlab = "Best r - second-best r")

############################################################
# View final ranked TF table
############################################################

TF_candidates %>%
  arrange(match_class, best_program, desc(best_r))

############################################################
# TF heatmap:
# remove TFs classified as "No program match"
############################################################

TF_candidates_filtered <- TF_candidates %>%
  filter(match_class != "No program match")

cor_matrix <- TF_candidates_filtered %>%
  select(TF, all_of(program_cols)) %>%
  column_to_rownames("TF") %>%
  as.matrix()

ord <- TF_candidates_filtered %>%
  arrange(best_program, desc(best_r)) %>%
  pull(TF)

cor_matrix <- cor_matrix[
  intersect(ord, rownames(cor_matrix)),
  , drop = FALSE]

pheatmap(
