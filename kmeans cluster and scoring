      cor(perm_profile, centroid, method = "pearson", use = "pairwise.complete.obs")})

    max(perm_cor, na.rm = TRUE)})

  empirical_p <- (sum(null_best_r >= obs_best_r) + 1) / (n_perm + 1)

  tibble(TF = tf, empirical_p = empirical_p)})

