library(cluster)
library(factoextra)
library(ggplot2)

sub_adult$celltype_timepoint <- paste(sub_adult$idents,sub_adult$timepoint,sep = "_")

agg <- AggregateExpression(sub_adult,assays = "RNA",features = hscr_genes,group.by = "celltype_timepoint",return.seurat = TRUE,normalization.method = "LogNormalize",scale.factor = 10000)

expression_matrix <- LayerData(agg,assay = "RNA",layer = "data")

expression_matrix <- as.matrix(expression_matrix)

expression_matrix_scaled <- t(scale(t(expression_matrix)))

# Remove genes with zero variance
expression_matrix_scaled <- expression_matrix_scaled[complete.cases(expression_matrix_scaled),]

x<-as.matrix(expression_matrix_scaled)

