############################################################
# 2. Get exact silhouette values for every k
############################################################

sil_results <- data.frame(k = 2:k_max,silhouette = NA_real_)

set.seed(123)

for (k in 2:k_max) {

  km <- kmeans(x,centers = k,nstart = 100,iter.max = 100)

  sil <- silhouette(
    km$cluster,
    dist(x))

  sil_results$silhouette[sil_results$k == k] <- mean(sil[, "sil_width"])}

print(sil_results)

# k with highest average silhouette
best_k_sil <- sil_results$k[which.max(sil_results$silhouette)]

cat("\nBest k by silhouette =",best_k_sil,"\n")


############################################################
# 3. GAP STATISTIC
############################################################

set.seed(123)

gap <- clusGap(x,FUNcluster = kmeans,K.max = k_max,B = 500,nstart = 100)

# View numerical results
print(gap)

# Plot
fviz_gap_stat(gap) + labs(title = "Optimal k: Gap Statistic")

############################################################
# 4. Determine optimal k from gap statistic
#
# Tibshirani 1-SE criterion
############################################################
best_k_gap <- maxSE(gap$Tab[, "gap"],gap$Tab[, "SE.sim"],method = "Tibs2001SEmax")

cat("\nBest k by gap statistic =",best_k_gap,"\n")

############################################################
# 5. WSS / ELBOW METHOD
############################################################
p_wss <- fviz_nbclust(x,FUNcluster = kmeans,method = "wss",k.max = k_max,nstart = 100) +
  labs(title = "Optimal k: Elbow Method",
    x = "Number of clusters (k)",
    y = "Total within-cluster sum of squares")

p_wss

