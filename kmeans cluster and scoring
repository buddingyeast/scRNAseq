              "Sema3d","Nrg1","Acss2","Adamts17","Eno3","Prxl2a","Sh3pxd2a","Slc27a4","Ubr4","Phgdh",
              "Nes","Rpf1","Eftud2","Yars2","Gigyf1","Rps6ka1","Supt16","Stat5b","Stat1","Stat3","Stat6",
              "Tbx2","Tbx3","Meis2","Meis3","Pknox2","Tgif2","Glis2","Gli1","Maz","Plagl1","Snai1","Snai2",
              "Plagl2","Vezf1","Zbtb26","Zfx","Zbtb7a","Zbtb7b","Osr2","Tcf12","Tcf3","Bnc2","Patz1","Ebf1","Ebf3",
              "Hey1","Maf","Mafk","Mafg","Sp2","Sp4","Klf7","Klf9","Egr1","Klf13","Klf3","Klf4","Klf5","Klf10","Klf2","Klf6",
              "Etv6","Erg","Gabpa","Ehf","Elf1","Elf3","Etv1","Hand2","Tcf21","Zfp335","Etv4","Jdp2","Fos","Fosl2","Atf3","Nfe2l1","Tcf7l1","Rbpj","Hand1","Tal1","Nfat5","Nfatc2")

candidate_TFs<-setdiff(analysis_genes,hscr_genes)

# Z-score each gene across cell × stage states
############################################################

z_expr <- t(apply(expression_matrix_scaled,1,
    function(x) {
      if (sd(x, na.rm = TRUE) == 0) {
        rep(NA, length(x))
      } else {
        as.numeric(scale(x))}}))

rownames(z_expr) <- rownames(expression_matrix_scaled)
colnames(z_expr) <- colnames(expression_matrix_scaled)

############################################################
# HSCR program centroids
############################################################
hscr_cluster_df <- hscr_clusters %>%filter(gene %in% hscr_genes)
cluster_ids <- sort(unique(hscr_cluster_df$cluster))
cluster_centroids <- sapply(
  cluster_ids,function(cl) {
    genes_in_cluster <- hscr_cluster_df %>%
      filter(cluster == cl) %>%pull(gene)

    # Keep genes actually present in expression matrix
    genes_in_cluster <- intersect(
      genes_in_cluster,
      rownames(z_expr))

    message("Cluster ", cl,": ", length(genes_in_cluster)," genes used")

    colMeans(z_expr[genes_in_cluster, , drop = FALSE],na.rm = TRUE)})

colnames(cluster_centroids) <- paste0("C", cluster_ids)

############################################################
# TF → HSCR-program correlations
############################################################

tf_program_cor <- map_dfr(
  candidate_TFs,
  function(tf) {
    
    if (!tf %in% rownames(z_expr)) {
      return(NULL)
    }
    
    tf_profile <- z_expr[tf, ]
    
    correlations <- apply(
      cluster_centroids,
      2,
      function(centroid) {
        cor(
          tf_profile,
          centroid,
          method = "pearson",
          use = "pairwise.complete.obs")})
    
    tibble(
      TF = tf,
      C1 = correlations["C1"],
      C2 = correlations["C2"],
      C3 = correlations["C3"],
      C4 = correlations["C4"])})

############################################################
# Determine best positive HSCR-program match
############################################################

tf_program_cor <- tf_program_cor %>%
  rowwise() %>%
  mutate(best_r = max(c_across(C1:C4), na.rm = TRUE),best_program = names(
      which.max(
        c(C1 = C1,
          C2 = C2,
          C3 = C3,
          C4 = C4)))) %>% ungroup() %>% arrange(desc(best_r)) %>%
  mutate(best_program = sub(".*\\.", "", best_program))

tf_program_cor

############################################################
# Extract RNA counts
############################################################

counts <- GetAssayData(sub_adult, assay = "SCT", layer = "counts")

meta <- sub_adult@meta.data

############################################################
# Calculate % expressing by cell × stage
############################################################

pct_expr_list <- lapply(
  valid_groups,
  function(group) {
    cells <- rownames(meta)[
      meta$celltype_timepoint == group]
    
    tf_present <- intersect(
      candidate_TFs,
      rownames(counts))
    
    pct <- Matrix::rowMeans(
      counts[
        tf_present,
        cells,
        drop = FALSE
      ] > 0) * 100
    
    tibble(
      TF = names(pct),
      cell_stage = group,
      pct_expressing = as.numeric(pct))})

tf_pct <- bind_rows(pct_expr_list)

############################################################
# Average expression long format
############################################################

tf_avg_long <- expression_matrix_scaled[
  intersect(candidate_TFs, rownames(expression_matrix_scaled)),,drop = FALSE] %>%
  as.data.frame() %>%
  rownames_to_column("TF") %>%
  pivot_longer(-TF, names_to = "cell_stage", values_to = "avg_expression")

tf_expression <- tf_avg_long %>%
  mutate(cell_stage = gsub("-", "_", cell_stage)) %>%
  left_join(tf_pct %>% mutate(cell_stage = gsub("-", "_", cell_stage)),by = c("TF", "cell_stage"))

############################################################
# Identify states in which each HSCR program is relatively high
############################################################

active_states <- lapply(
  colnames(cluster_centroids),
  function(cl) {
    rownames(cluster_centroids)[
      cluster_centroids[, cl] > 0]})

names(active_states) <- colnames(cluster_centroids)

############################################################
# Program-specific TF prevalence
############################################################

program_expression_stats <- map_dfr(
  1:nrow(tf_program_cor),
  function(i) {
    tf <- tf_program_cor$TF[i]
    program <- tf_program_cor$best_program[i]
    
    # Get states and convert hyphens to underscores to match tf_expression
    states <- gsub("-", "_", active_states[[program]])
    
    dat <- tf_expression %>%
      filter(
        TF == tf,
        cell_stage %in% states)
    
    tibble(
      TF = tf,
      best_program = program,
      mean_pct_active_states = if(nrow(dat) > 0) mean(dat$pct_expressing, na.rm = TRUE) else NA_real_,
      mean_expression_active_states = if(nrow(dat) > 0) mean(dat$avg_expression, na.rm = TRUE) else NA_real_)})
############################################################
# Final TF candidate table
############################################################

TF_candidates <- tf_program_cor %>% left_join(program_expression_stats,by = c("TF", "best_program")) %>% arrange(desc(best_r))

TF_candidates_all <- TF_candidates %>%
  rowwise() %>%
  mutate(  
    strongest_abs_r = max(
      abs(c_across(C1:C4)),
      na.rm = TRUE),
    
    strongest_abs_program = names(
      which.max(abs(c(
            C1 = C1,
            C2 = C2,
            C3 = C3,
            C4 = C4
          ))))) %>%ungroup()

TF_candidates_all<-TF_candidates_all %>% mutate(strongest_abs_program = sub(".*\\.", "", strongest_abs_program))
